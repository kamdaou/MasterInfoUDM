{% extends 'base.html.twig' %}
{% block title %}Commandes | Commande Studio{% endblock %}
{% block body %}
<section class="page-heading"><div><p class="eyebrow">VENTES</p><h1>Commandes</h1><p class="muted">Suivez les ventes et gérez les produits de chaque commande.</p></div><a class="button button-primary" href="{{ path('app_order_new') }}"><span aria-hidden="true">+</span> Nouvelle commande</a></section>
<div class="order-list">{% for order in orders %}<article class="panel order-panel"><div class="order-heading"><div><span class="order-number">COMMANDE #{{ order.idCmd }}</span><h2>{{ order.prenomCli }} {{ order.nomCli }}</h2><p class="muted">{{ order.dateCmd|date('d/m/Y') }}{% if order.email %} · {{ order.email }}{% endif %}</p></div><div class="order-total"><span>Total</span><strong>{{ order.total|number_format(0, ',', ' ') }} FCFA</strong><small>{{ order.units }} unité{{ order.units != 1 ? 's' : '' }}</small></div></div>
<div class="order-actions"><a class="text-link" href="{{ path('app_order_detail', {id: order.idCmd}) }}">Voir le détail <span aria-hidden="true">→</span></a><a class="text-link" href="{{ path('app_order_edit', {id: order.idCmd}) }}">Modifier</a><form method="post" action="{{ path('app_order_delete', {id: order.idCmd}) }}" onsubmit="return confirm('Supprimer cette commande et restituer son stock ?')"><input type="hidden" name="_token" value="{{ csrf_token('delete_order_' ~ order.idCmd) }}"><button class="text-button delete-text" type="submit">Supprimer</button></form></div>
{% if order.lines %}<div class="table-wrap order-lines"><table><thead><tr><th>Produit</th><th>Quantité</th><th>Prix unitaire</th><th>Montant</th><th></th></tr></thead><tbody>{% for line in order.lines %}<tr><td class="primary-cell">{{ line.designProd }}</td><td>{{ line.qteCmd }}</td><td>{{ line.prixUProd|number_format(0, ',', ' ') }} FCFA</td><td>{{ (line.qteCmd * line.prixUProd)|number_format(0, ',', ' ') }} FCFA</td><td class="table-action"><form method="post" action="{{ path('app_order_line_delete', {orderId: order.idCmd, productId: line.idProd}) }}"><input type="hidden" name="_token" value="{{ csrf_token('delete_line_' ~ order.idCmd ~ '_' ~ line.idProd) }}"><button class="icon-link delete-link" type="submit" aria-label="Supprimer {{ line.designProd }} de la commande" title="Supprimer">×</button></form></td></tr>{% endfor %}</tbody></table></div>{% endif %}
<form class="inline-add" method="post" action="{{ path('app_order_line_add', {orderId: order.idCmd}) }}"><input type="hidden" name="_token" value="{{ csrf_token('order_line_' ~ order.idCmd) }}"><label class="visually-hidden" for="product-{{ order.idCmd }}">Produit</label><select id="product-{{ order.idCmd }}" name="idProd" required><option value="">Ajouter un produit…</option>{% for product in products|default([]) %}<option value="{{ product.idProd }}">{{ product.designProd }} · {{ product.qteStock }} en stock</option>{% endfor %}</select><label class="visually-hidden" for="quantity-{{ order.idCmd }}">Quantité</label><input id="quantity-{{ order.idCmd }}" name="qteCmd" type="number" min="1" value="1" required><button class="button button-primary" type="submit">Ajouter</button></form></article>{% else %}<section class="panel empty-state">Aucune commande disponible.</section>{% endfor %}</div>
{% endblock %}