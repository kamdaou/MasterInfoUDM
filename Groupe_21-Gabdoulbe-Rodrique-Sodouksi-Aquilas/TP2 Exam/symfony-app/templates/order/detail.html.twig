{% extends 'base.html.twig' %}
{% block title %}Commande #{{ order.idCmd }} | Commande Studio{% endblock %}
{% block body %}
<section class="page-heading"><div><p class="eyebrow">DÉTAIL DE VENTE</p><h1>Commande #{{ order.idCmd }}</h1><p class="muted">{{ order.dateCmd|date('d/m/Y') }} · {{ order.prenomCli }} {{ order.nomCli }}{% if order.email %} · {{ order.email }}{% endif %}</p></div><a class="button button-quiet" href="{{ path('app_orders') }}">← Retour aux commandes</a></section>
<section class="metrics-grid detail-metrics"><article class="metric metric-dark"><span class="metric-label">Montant total</span><strong>{{ order.total|number_format(0, ',', ' ') }} <small>FCFA</small></strong><span class="metric-foot">Commande du {{ order.dateCmd|date('d/m/Y') }}</span></article><article class="metric"><span class="metric-label">Articles</span><strong>{{ lines|length }}</strong><span class="metric-foot">Références distinctes</span></article><article class="metric"><span class="metric-label">Unités</span><strong>{{ order.units }}</strong><span class="metric-foot">Quantité totale</span></article><article class="metric"><span class="metric-label">Client</span><strong class="metric-name">{{ order.prenomCli }} {{ order.nomCli }}</strong><span class="metric-foot">{{ order.email|default('Sans e-mail') }}</span></article></section>
<section class="panel"><div class="panel-heading"><h2>Articles commandés</h2><a class="text-link" href="{{ path('app_order_edit', {id: order.idCmd}) }}">Modifier la commande</a></div>{% if lines %}<div class="table-wrap"><table><thead><tr><th>Produit</th><th>Quantité</th><th>Prix unitaire</th><th>Montant</th><th></th></tr></thead><tbody>{% for line in lines %}<tr><td class="primary-cell">{{ line.designProd }}</td><td>{{ line.qteCmd }}</td><td>{{ line.prixUProd|number_format(0, ',', ' ') }} FCFA</td><td>{{ line.line_total|number_format(0, ',', ' ') }} FCFA</td><td class="table-action"><form method="post" action="{{ path('app_order_line_delete', {orderId: order.idCmd, productId: line.idProd}) }}"><input type="hidden" name="_token" value="{{ csrf_token('delete_line_' ~ order.idCmd ~ '_' ~ line.idProd) }}"><button class="icon-link delete-link" type="submit" aria-label="Supprimer {{ line.designProd }} de la commande" title="Supprimer">×</button></form></td></tr>{% endfor %}</tbody></table></div>{% else %}<p class="empty-state">Aucun produit n’a encore été ajouté à cette commande.</p>{% endif %}</section>
{% endblock %}