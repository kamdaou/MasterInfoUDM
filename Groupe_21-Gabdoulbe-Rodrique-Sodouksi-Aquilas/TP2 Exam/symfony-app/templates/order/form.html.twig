{% extends 'base.html.twig' %}
{% block title %}{{ order ? 'Modifier la commande' : 'Nouvelle commande' }} | Commande Studio{% endblock %}
{% block body %}
<section class="page-heading"><div><p class="eyebrow">VENTES</p><h1>{{ order ? 'Modifier la commande' : 'Nouvelle commande' }}</h1><p class="muted">Choisissez le client et la date d’enregistrement.</p></div><a class="button button-quiet" href="{{ path('app_orders') }}">← Retour aux commandes</a></section>
<section class="panel form-panel"><form method="post" class="stack-form"><input type="hidden" name="_token" value="{{ csrf_token('order_form') }}"><label>Client<select name="idCli" required><option value="">Sélectionner un client…</option>{% for customer in customers %}<option value="{{ customer.idCli }}" {{ formData.idCli == customer.idCli ? 'selected' : '' }}>{{ customer.prenomCli }} {{ customer.nomCli }}</option>{% endfor %}</select></label><label>Date de commande<input name="dateCmd" type="date" required value="{{ formData.dateCmd }}"></label>{% if not customers %}<p class="form-hint">Créez d’abord un client pour pouvoir enregistrer une commande.</p>{% endif %}<div class="form-actions"><a class="button button-quiet" href="{{ path('app_orders') }}">Annuler</a><button class="button button-primary" type="submit" {{ not customers ? 'disabled' : '' }}>{{ order ? 'Enregistrer' : 'Créer la commande' }}</button></div></form></section>
{% endblock %}