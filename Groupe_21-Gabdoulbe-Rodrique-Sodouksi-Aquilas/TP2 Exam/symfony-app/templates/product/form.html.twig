{% extends 'base.html.twig' %}
{% block title %}{{ product ? 'Modifier le produit' : 'Nouveau produit' }} | Commande Studio{% endblock %}
{% block body %}
<section class="page-heading"><div><p class="eyebrow">CATALOGUE</p><h1>{{ product ? 'Modifier le produit' : 'Nouveau produit' }}</h1><p class="muted">Les champs marqués sont requis pour le suivi du stock.</p></div><a class="button button-quiet" href="{{ path('app_products') }}">← Retour au catalogue</a></section>
<section class="panel form-panel"><form method="post" class="stack-form"><input type="hidden" name="_token" value="{{ csrf_token('product_form') }}"><label>Nom du produit<input name="designProd" required maxlength="255" value="{{ product.designProd|default('') }}" autocomplete="off"></label><div class="form-row"><label>Quantité en stock<input name="qteStock" type="number" min="0" step="1" required value="{{ product.qteStock|default(0) }}"></label><label>Prix unitaire (FCFA)<input name="prixUProd" type="number" min="0" step="1" required value="{{ product.prixUProd|default('') }}"></label></div><label>URL de la photo <span class="optional">(facultatif)</span><input name="photoProd" type="url" maxlength="255" value="{{ product.photoProd|default('') }}" placeholder="https://..."></label><div class="form-actions"><a class="button button-quiet" href="{{ path('app_products') }}">Annuler</a><button class="button button-primary" type="submit">{{ product ? 'Enregistrer' : 'Créer le produit' }}</button></div></form></section>
{% endblock %}