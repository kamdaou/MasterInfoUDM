{% extends 'base.html.twig' %}
{% block title %}Produits | Commande Studio{% endblock %}
{% block body %}
<section class="page-heading"><div><p class="eyebrow">CATALOGUE</p><h1>Produits</h1><p class="muted">Références, prix unitaires et disponibilité.</p></div><a class="button button-primary" href="{{ path('app_product_new') }}"><span aria-hidden="true">+</span> Nouveau produit</a></section>
<section class="panel"><div class="panel-heading"><h2>{{ products|length }} référence{{ products|length != 1 ? 's' : '' }}</h2></div>
{% if products %}<div class="table-wrap"><table><thead><tr><th>Produit</th><th>Stock</th><th>Prix unitaire</th><th></th></tr></thead><tbody>{% for product in products %}<tr><td class="primary-cell">{{ product.designProd }}<span class="cell-detail">Réf. #{{ product.idProd }}</span></td><td><span class="stock {{ product.qteStock < 5 ? 'stock-low' : '' }}">{{ product.qteStock }} unité{{ product.qteStock != 1 ? 's' : '' }}</span></td><td>{{ product.prixUProd|number_format(0, ',', ' ') }} FCFA</td><td class="table-action"><a class="icon-link" href="{{ path('app_product_edit', {id: product.idProd}) }}" aria-label="Modifier {{ product.designProd }}" title="Modifier">✎</a></td></tr>{% endfor %}</tbody></table></div>{% else %}<p class="empty-state">Le catalogue est vide. Ajoutez votre premier produit.</p>{% endif %}</section>
{% endblock %}