{% extends 'base.html.twig' %}
{% block title %}Vue d’ensemble | Commande Studio{% endblock %}
{% block body %}
<section class="page-heading">
    <div><p class="eyebrow">ESPACE DE PILOTAGE</p><h1>Vue d’ensemble</h1><p class="muted">Activité des commandes et état du catalogue.</p></div>
    <a class="button button-primary" href="{{ path('app_product_new') }}"><span aria-hidden="true">+</span> Nouveau produit</a>
</section>
<section class="metrics-grid" aria-label="Indicateurs principaux">
    <article class="metric metric-dark"><span class="metric-label">Chiffre d’affaires</span><strong>{{ summary.revenue|number_format(0, ',', ' ') }} <small>FCFA</small></strong><span class="metric-foot">Total des lignes de commande</span></article>
    <article class="metric"><span class="metric-label">Ce mois-ci</span><strong>{{ summary.monthRevenue|number_format(0, ',', ' ') }} <small>FCFA</small></strong><span class="metric-foot">Chiffre d’affaires mensuel</span></article>
    <article class="metric"><span class="metric-label">Commandes</span><strong>{{ summary.orders }}</strong><span class="metric-foot">Enregistrées</span></article>
    <article class="metric"><span class="metric-label">Unités vendues</span><strong>{{ summary.units }}</strong><span class="metric-foot">Toutes commandes confondues</span></article>
    <article class="metric"><span class="metric-label">Références produit</span><strong>{{ summary.products }}</strong><span class="metric-foot">{{ summary.customers }} clients</span></article>
</section>
<section class="panel monthly-panel">
    <div class="panel-heading"><div><p class="eyebrow">TENDANCE</p><h2>Chiffre d’affaires sur six mois</h2></div><span class="chart-unit">FCFA</span></div>
    <div class="monthly-chart" role="img" aria-label="Chiffre d’affaires mensuel sur les six derniers mois">{% for month in monthlySales %}<div class="month-column"><span class="month-value">{{ month.revenue|number_format(0, ',', ' ') }}</span><div class="bar-track"><div class="bar-fill" style="height: {{ month.percentage }}%"></div></div><span class="month-label">{{ month.label }}</span></div>{% endfor %}</div>
</section>
<section class="dashboard-grid">
    <article class="panel">
        <div class="panel-heading"><div><p class="eyebrow">PERFORMANCE</p><h2>Meilleures ventes</h2></div><a class="text-link" href="{{ path('app_products') }}">Catalogue <span aria-hidden="true">→</span></a></div>
        {% if topProducts %}<div class="table-wrap"><table><thead><tr><th>Produit</th><th>Unités</th><th>Montant</th></tr></thead><tbody>{% for product in topProducts %}<tr><td class="primary-cell">{{ product.designProd }}</td><td>{{ product.units }}</td><td>{{ product.revenue|number_format(0, ',', ' ') }} FCFA</td></tr>{% endfor %}</tbody></table></div>{% else %}<p class="empty-state">Aucune vente enregistrée pour le moment.</p>{% endif %}
    </article>
    <article class="panel">
        <div class="panel-heading"><div><p class="eyebrow">RÉCENT</p><h2>Dernières commandes</h2></div><a class="text-link" href="{{ path('app_orders') }}">Tout voir <span aria-hidden="true">→</span></a></div>
        {% if recentOrders %}<div class="table-wrap"><table><thead><tr><th>Commande</th><th>Client</th><th>Total</th></tr></thead><tbody>{% for order in recentOrders %}<tr><td class="primary-cell">#{{ order.idCmd }}<span class="cell-detail">{{ order.dateCmd|date('d/m/Y') }}</span></td><td>{{ order.prenomCli }} {{ order.nomCli }}</td><td>{{ order.total|number_format(0, ',', ' ') }} FCFA</td></tr>{% endfor %}</tbody></table></div>{% else %}<p class="empty-state">Aucune commande enregistrée.</p>{% endif %}
    </article>
</section>
<section class="dashboard-grid dashboard-bottom">
    <article class="panel">
        <div class="panel-heading"><div><p class="eyebrow">FIDÉLITÉ</p><h2>Meilleurs clients</h2></div><a class="text-link" href="{{ path('app_customers') }}">Tous les clients <span aria-hidden="true">→</span></a></div>
        {% if topCustomers %}<div class="table-wrap"><table><thead><tr><th>Client</th><th>Commandes</th><th>Montant</th></tr></thead><tbody>{% for customer in topCustomers %}<tr><td class="primary-cell">{{ customer.prenomCli }} {{ customer.nomCli }}</td><td>{{ customer.order_count }}</td><td>{{ customer.revenue|number_format(0, ',', ' ') }} FCFA</td></tr>{% endfor %}</tbody></table></div>{% else %}<p class="empty-state">Aucun achat enregistré.</p>{% endif %}
    </article>
    <article class="panel">
        <div class="panel-heading"><div><p class="eyebrow">RÉAPPROVISIONNEMENT</p><h2>Stock bas</h2></div><a class="text-link" href="{{ path('app_products') }}">Catalogue <span aria-hidden="true">→</span></a></div>
        {% if lowStock %}<div class="table-wrap"><table><thead><tr><th>Produit</th><th>Disponible</th></tr></thead><tbody>{% for product in lowStock %}<tr><td class="primary-cell">{{ product.designProd }}</td><td><span class="stock stock-low">{{ product.qteStock }} unité{{ product.qteStock != 1 ? 's' : '' }}</span></td></tr>{% endfor %}</tbody></table></div>{% else %}<p class="empty-state">Aucun produit sous le seuil de 5 unités.</p>{% endif %}
    </article>
</section>
{% endblock %}