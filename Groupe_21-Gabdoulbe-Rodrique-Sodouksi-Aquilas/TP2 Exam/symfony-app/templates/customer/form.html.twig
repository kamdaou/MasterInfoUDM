{% extends 'base.html.twig' %}
{% block title %}{{ customer ? 'Modifier le client' : 'Nouveau client' }} | Commande Studio{% endblock %}
{% block body %}
<section class="page-heading"><div><p class="eyebrow">RELATIONS CLIENTS</p><h1>{{ customer ? 'Modifier le client' : 'Nouveau client' }}</h1><p class="muted">Nom et prénom requis. Les autres coordonnées sont facultatives.</p></div><a class="button button-quiet" href="{{ path('app_customers') }}">← Retour aux clients</a></section>
<section class="panel form-panel"><form method="post" class="stack-form"><input type="hidden" name="_token" value="{{ csrf_token('customer_form') }}"><div class="form-row"><label>Prénom<input name="prenomCli" required maxlength="150" value="{{ formData.prenomCli }}" autocomplete="given-name"></label><label>Nom<input name="nomCli" required maxlength="150" value="{{ formData.nomCli }}" autocomplete="family-name"></label></div><label>Adresse e-mail <span class="optional">(facultative)</span><input name="email" type="email" maxlength="190" value="{{ formData.email }}" autocomplete="email"></label><div class="form-row"><label>Région<select name="idRegion"><option value="">Sans région</option>{% for region in regions %}<option value="{{ region.idRegion }}" {{ formData.idRegion == region.idRegion ? 'selected' : '' }}>{{ region.nomRegion }}</option>{% endfor %}</select></label><label>URL de la photo <span class="optional">(facultative)</span><input name="photo" type="url" maxlength="255" value="{{ formData.photo }}" placeholder="https://..."></label></div><div class="form-actions"><a class="button button-quiet" href="{{ path('app_customers') }}">Annuler</a><button class="button button-primary" type="submit">{{ customer ? 'Enregistrer' : 'Créer le client' }}</button></div></form></section>
{% endblock %}