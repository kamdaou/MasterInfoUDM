{% extends 'base.html.twig' %}
{% block title %}Clients | Commande Studio{% endblock %}
{% block body %}
<section class="page-heading"><div><p class="eyebrow">RELATIONS CLIENTS</p><h1>Clients</h1><p class="muted">Coordonnées et activité de la clientèle.</p></div><a class="button button-primary" href="{{ path('app_customer_new') }}"><span aria-hidden="true">+</span> Nouveau client</a></section>
<section class="panel"><div class="panel-heading"><h2>{{ customers|length }} client{{ customers|length != 1 ? 's' : '' }}</h2></div>{% if customers %}<div class="table-wrap"><table><thead><tr><th>Client</th><th>Adresse e-mail</th><th>Région</th><th>Commandes</th><th></th></tr></thead><tbody>{% for customer in customers %}<tr><td class="primary-cell">{{ customer.prenomCli }} {{ customer.nomCli }}<span class="cell-detail">Client #{{ customer.idCli }}</span></td><td>{{ customer.email|default('—') }}</td><td>{{ customer.nomRegion|default('—') }}</td><td>{{ customer.order_count }}</td><td class="table-action"><a class="icon-link" href="{{ path('app_customer_edit', {id: customer.idCli}) }}" aria-label="Modifier {{ customer.prenomCli }} {{ customer.nomCli }}" title="Modifier">✎</a><form class="inline-form" method="post" action="{{ path('app_customer_delete', {id: customer.idCli}) }}"><input type="hidden" name="_token" value="{{ csrf_token('delete_customer_' ~ customer.idCli) }}"><button class="icon-link delete-link" type="submit" aria-label="Supprimer {{ customer.prenomCli }} {{ customer.nomCli }}" title="Supprimer">×</button></form></td></tr>{% endfor %}</tbody></table></div>{% else %}<p class="empty-state">Aucun client enregistré. Créez un client avant d'enregistrer une commande.</p>{% endif %}</section>
{% endblock %}